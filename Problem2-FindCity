
class Solution {
    public int findTheCity(int n, int[][] edges, int distanceThreshold) {
        // note to self : 1st index - rows | 2nd index - columns (in matrix)
        //              : contraints say that wt is from 1 to 10000 so when points
        //                don't connect, we can put their wt in distance matrix as
        //                a value larger than 10000 (like 10001)

        int[][] dist =  new int[n][n]; // declare distance matrix

        // POPULATING DISTANCE MATRIX----
        for (int i = 0; i < n; ++i) {
            Arrays.fill(dist[i], 10001);
            dist[i][i] = 0;
        }

        for (int[] edge : edges) {
            int u = edge[0]; // from
            int v = edge[1]; // to
            int w = edge[2]; // weight

            // this graph is bidirectional so going from 0 to 1 and 1 to 0 have same weight
            dist[u][v] = w;
            dist[v][u] = w;
        }


        // k --> the intercepting point; from point i to k to j
        for (int k = 0; k < n; ++k) {
            for (int i = 0; i < n; ++i) {
                for (int j = 0; j < n; ++j) {
                    /* 
                        Checks if distance from point i to j is greater than
                        distance from point i to k to j :
                        if true then we replace the distance in distance matrix
                    */
                    if (dist[i][j] > (dist[i][k] + dist[k][j])) {
                        dist[i][j] = dist[i][k] + dist[k][j];
                    }
                }
            }
        }


        // FINDING THE CITY----
        int minWt = -1;
        int index = -1;

        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if (dist[i][j] <= distanceThreshold) {
                    if ((dist[i][j] <= minWt)) {
                        minWt = dist[i][j];
                        index = i;
                    } 
                }
                
            }
        }

        return index;
        
    }
}
